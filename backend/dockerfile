# Giai đoạn 1: Dùng image có sẵn Maven và JDK 21 để build
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app

# Copy toàn bộ source code vào container
COPY . .

# Ghi đè file cấu hình production (bỏ dấu # ở 2 dòng dưới nếu bạn cần dùng)
# RUN cp src/main/resources/pro-application.properties \
#        src/main/resources/application.properties

# Build bằng lệnh mvn trực tiếp (không cần ./mvnw)
RUN mvn clean package -DskipTests

# Giai đoạn 2: Dùng JRE 21 Alpine siêu nhẹ để chạy ứng dụng
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Copy file .jar đã đóng gói từ giai đoạn 1 sang
COPY --from=build /app/target/*.jar app.jar

EXPOSE 8080

# Giới hạn RAM tối đa 350MB (-Xmx350m) để tránh sập app trên gói Free 512MB của Render
ENTRYPOINT ["sh", "-c", "java -Xmx350m -jar app.jar"]
